APP_NAME="Eurofurence Creator System"
ENVIRONMENT="development"

SESSION_SECRET="INSERT_SESSION_SECRET"
SESSION_MAX_AGE=1209600 # Signed session lifetime in seconds (14 days).

DATABASE_URL="postgresql+psycopg://creators:creators@db:5432/creators"
# Local Event ID; no calendar-year fallback.
ACTIVE_EVENT_ID=
# Explicit local-only adapter; manual_test is rejected outside development/test.
# Default is fail-closed. Manual records require a private, untracked JSON file.
REGISTRATION_PROVIDER=unavailable
REGISTRATION_MANUAL_FILE=
BADGE_SEQUENCE_START=1
PROFILE_IMAGE_MAX_BYTES=10485760
INVITATION_ATTEMPTS_PER_MINUTE=10
# Trusted module:factory implementing the approved EF notification adapter.
# Unset reports unavailable; never falls back to SMTP.
NOTIFICATION_PROVIDER_FACTORY=

S3_ENDPOINT_URL=http://s3:9090
S3_BUCKET=creators
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_REGION=us-east-1

OIDC_ISSUER_URL=https://identity.eurofurence.org/
OIDC_CLIENT_ID="INSERT_CLIENT_ID"
OIDC_CLIENT_SECRET="INSERT_CLIENT_SECRET"
OIDC_SERVER_METADATA_URL=https://identity.eurofurence.org/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=
